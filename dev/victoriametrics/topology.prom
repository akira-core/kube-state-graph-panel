# kube-state-graph demo topology fixture (kube-state-metrics-shaped).
#
# Mirrors the no-backend showcase (provisioning/dashboards/ksg-switch-demo.json)
# so the backend-driven `ksg-demo` dashboard renders the SAME controller topology
# off the local ksg backend. Pushed verbatim every tick by seed.sh via
# VictoriaMetrics /api/v1/import/prometheus, which stamps each sample at ingestion
# time so last_over_time(...[window]) always finds a fresh value. All series are
# gauges with value 1 (existence facts); the calls live in seed.sh as incrementing
# traces_service_graph_request_total counters (so rate(...[window]) > 0).
#
# Bucket A only — the backend has NO contract for the showcase's switch fabric,
# per-node status/alerts, or app/version/role pod labels, so those are absent here
# (hard backend limits, not omissions). Result: 19 nodes / 13 edges + 4 owners.
#
#   prod > {worker-0 > gateway, mongo-0, mongo-2; worker-1 > mongo-1; mongo-svc; 3 PVCs}
#   dr   > {worker-2 > consumer, nats-0, nats-1, nats-2; nats-svc}
# pod-runs-on-node is NOT a drawn edge — it IS the cluster > node > pod nesting.

# =====================================================================
# cluster: prod — MongoDB StatefulSet + gateway Deployment behind mongo-svc
# =====================================================================

# --- K8s nodes (worker-0, worker-1). ExternalIP surfaces as the node ipaddress. ---
kube_node_info{cluster="prod",node="worker-0"} 1
kube_node_info{cluster="prod",node="worker-1"} 1
kube_node_labels{cluster="prod",node="worker-0",label_topology_kubernetes_io_zone="us-east-1a",label_topology_kubernetes_io_region="us-east-1",label_kubernetes_io_os="linux"} 1
kube_node_labels{cluster="prod",node="worker-1",label_topology_kubernetes_io_zone="us-east-1b",label_topology_kubernetes_io_region="us-east-1",label_kubernetes_io_os="linux"} 1
kube_node_status_addresses{cluster="prod",node="worker-0",type="ExternalIP",address="10.0.1.10"} 1
kube_node_status_addresses{cluster="prod",node="worker-1",type="ExternalIP",address="10.0.1.11"} 1

# --- pods (labels.node drives cluster > node > pod nesting). ---
kube_pod_info{cluster="prod",namespace="prod",pod="gateway",uid="u-gateway",node="worker-0",pod_ip="10.244.1.30"} 1
kube_pod_info{cluster="prod",namespace="prod",pod="mongo-0",uid="u-mongo-0",node="worker-0",pod_ip="10.244.1.20"} 1
kube_pod_info{cluster="prod",namespace="prod",pod="mongo-1",uid="u-mongo-1",node="worker-1",pod_ip="10.244.2.21"} 1
kube_pod_info{cluster="prod",namespace="prod",pod="mongo-2",uid="u-mongo-2",node="worker-0"} 1

# --- pod owners -> data.owner -> synthesized controllers (Deployment gateway,
#     StatefulSet mongodb). owner_is_controller="true" required; kind verbatim. ---
kube_pod_owner{cluster="prod",namespace="prod",pod="gateway",owner_kind="Deployment",owner_name="gateway",owner_is_controller="true"} 1
kube_pod_owner{cluster="prod",namespace="prod",pod="mongo-0",owner_kind="StatefulSet",owner_name="mongodb",owner_is_controller="true"} 1
kube_pod_owner{cluster="prod",namespace="prod",pod="mongo-1",owner_kind="StatefulSet",owner_name="mongodb",owner_is_controller="true"} 1
kube_pod_owner{cluster="prod",namespace="prod",pod="mongo-2",owner_kind="StatefulSet",owner_name="mongodb",owner_is_controller="true"} 1

# --- PVCs (one per mongo replica) + pod-mounts-pvc. ---
kube_pod_spec_volumes_persistentvolumeclaims_info{cluster="prod",namespace="prod",pod="mongo-0",persistentvolumeclaim="data-mongo-0",volume="data"} 1
kube_pod_spec_volumes_persistentvolumeclaims_info{cluster="prod",namespace="prod",pod="mongo-1",persistentvolumeclaim="data-mongo-1",volume="data"} 1
kube_pod_spec_volumes_persistentvolumeclaims_info{cluster="prod",namespace="prod",pod="mongo-2",persistentvolumeclaim="data-mongo-2",volume="data"} 1

# --- mongo-svc ClusterIP service. A 2-label `mongo-svc.prod.svc…` connection
#     string resolves to this Service node + fans service-selects-pod to mongo-*. ---
kube_service_info{cluster="prod",namespace="prod",service="mongo-svc",cluster_ip="10.96.0.10"} 1
kube_endpointslice_labels{cluster="prod",namespace="prod",endpointslice="mongo-svc-djk2",label_kubernetes_io_service_name="mongo-svc"} 1
kube_endpointslice_endpoints{cluster="prod",namespace="prod",endpointslice="mongo-svc-djk2",targetref_kind="Pod",targetref_namespace="prod",targetref_name="mongo-0"} 1
kube_endpointslice_endpoints{cluster="prod",namespace="prod",endpointslice="mongo-svc-djk2",targetref_kind="Pod",targetref_namespace="prod",targetref_name="mongo-1"} 1
kube_endpointslice_endpoints{cluster="prod",namespace="prod",endpointslice="mongo-svc-djk2",targetref_kind="Pod",targetref_namespace="prod",targetref_name="mongo-2"} 1

# =====================================================================
# cluster: dr — NATS StatefulSet + consumer Deployment behind nats-svc
# =====================================================================

# --- K8s node (worker-2). ---
kube_node_info{cluster="dr",node="worker-2"} 1
kube_node_labels{cluster="dr",node="worker-2",label_topology_kubernetes_io_zone="eu-west-1a",label_topology_kubernetes_io_region="eu-west-1",label_kubernetes_io_os="linux"} 1
kube_node_status_addresses{cluster="dr",node="worker-2",type="ExternalIP",address="10.0.2.10"} 1

# --- pods (consumer + nats-0/1/2, all on worker-2). ---
kube_pod_info{cluster="dr",namespace="dr",pod="consumer",uid="u-consumer",node="worker-2"} 1
kube_pod_info{cluster="dr",namespace="dr",pod="nats-0",uid="u-nats-0",node="worker-2"} 1
kube_pod_info{cluster="dr",namespace="dr",pod="nats-1",uid="u-nats-1",node="worker-2"} 1
kube_pod_info{cluster="dr",namespace="dr",pod="nats-2",uid="u-nats-2",node="worker-2"} 1

# --- pod owners -> Deployment consumer, StatefulSet nats. ---
kube_pod_owner{cluster="dr",namespace="dr",pod="consumer",owner_kind="Deployment",owner_name="consumer",owner_is_controller="true"} 1
kube_pod_owner{cluster="dr",namespace="dr",pod="nats-0",owner_kind="StatefulSet",owner_name="nats",owner_is_controller="true"} 1
kube_pod_owner{cluster="dr",namespace="dr",pod="nats-1",owner_kind="StatefulSet",owner_name="nats",owner_is_controller="true"} 1
kube_pod_owner{cluster="dr",namespace="dr",pod="nats-2",owner_kind="StatefulSet",owner_name="nats",owner_is_controller="true"} 1

# --- nats-svc ClusterIP service + service-selects-pod fan-out to nats-*. ---
kube_service_info{cluster="dr",namespace="dr",service="nats-svc",cluster_ip="10.96.0.50"} 1
kube_endpointslice_labels{cluster="dr",namespace="dr",endpointslice="nats-svc-7f9q",label_kubernetes_io_service_name="nats-svc"} 1
kube_endpointslice_endpoints{cluster="dr",namespace="dr",endpointslice="nats-svc-7f9q",targetref_kind="Pod",targetref_namespace="dr",targetref_name="nats-0"} 1
kube_endpointslice_endpoints{cluster="dr",namespace="dr",endpointslice="nats-svc-7f9q",targetref_kind="Pod",targetref_namespace="dr",targetref_name="nats-1"} 1
kube_endpointslice_endpoints{cluster="dr",namespace="dr",endpointslice="nats-svc-7f9q",targetref_kind="Pod",targetref_namespace="dr",targetref_name="nats-2"} 1
