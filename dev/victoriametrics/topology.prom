# kube-state-graph demo topology fixture (kube-state-metrics-shaped).
#
# Mirrors the no-backend showcase (provisioning/dashboards/ksg-switch-demo.json)
# so the backend-driven `ksg-demo` dashboard renders the SAME controller topology
# off the local ksg backend. Pushed verbatim every tick by seed.sh via
# VictoriaMetrics /api/v1/import/prometheus, which stamps each sample at ingestion
# time so last_over_time(...[window]) always finds a fresh value. All series are
# gauges with value 1 (existence facts); the calls live in seed.sh as incrementing
# traces_service_graph_request_total counters (so rate(...[window]) > 0).
#
# Bucket A only — the backend has NO contract for the showcase's switch fabric,
# per-node status/alerts, or generic pod labels (kube_pod_labels: app/version/role,
# read by the hover tooltip), so those are absent here (hard backend limits). It DOES
# derive each pod's ArgoCD `application` (from the argocd_tracking_id label on
# kube_pod_owner, below) and `containers` (from kube_pod_container_info, below); both
# surface in the node-detail panel. Services and PVCs ALSO derive an ArgoCD
# `application` — from the annotation_argocd_argoproj_io_tracking_id label on
# kube_service_annotations / kube_persistentvolumeclaim_annotations (below) — so each
# nests under its application group exactly like a pod (cluster > namespace >
# application > {service, pvc}); an annotation-less service/pvc falls back to the
# namespace group.
#
# Backend design D6 (commit 787573b) owns the WHOLE hierarchy and emits, in the
# /v1/graph cytoscape payload: `namespace` / `application` / `controller` group nodes,
# the full parent chain `cluster > namespace > application > controller > pod`, a
# `storageclass` LEAF under the cluster (from kube_storageclass_info, with provisioner),
# `pod-to-node` edges (pod → its K8s node — no longer nesting), and `pvc-to-storageclass`
# edges (pvc → storageclass). The panel consumes this verbatim (no client synthesis).
#
#   prod > ns/prod > {app mongodb > [ctrl mongodb > mongo-0/1/2; mongo-svc; data-mongo-0/1/2];
#                     app gateway > ctrl gateway > gateway}
#          + worker-0/1 (leaves) + storageclass fast-ssd (leaf)
#   dr   > ns/dr > {app nats > [ctrl nats > nats-0/1/2; nats-svc]; app consumer > ctrl consumer > consumer}
#          + worker-2 (leaf)
# pod-to-node IS a drawn edge in controller view; node view re-nests pod under node.

# =====================================================================
# cluster: prod — MongoDB StatefulSet + gateway Deployment behind mongo-svc
# =====================================================================

# --- K8s nodes (worker-0, worker-1). ExternalIP surfaces as the node ipaddress. ---
kube_node_info{cluster="prod",node="worker-0"} 1
kube_node_info{cluster="prod",node="worker-1"} 1
kube_node_labels{cluster="prod",node="worker-0",label_topology_kubernetes_io_zone="us-east-1a",label_topology_kubernetes_io_region="us-east-1",label_kubernetes_io_os="linux"} 1
kube_node_labels{cluster="prod",node="worker-1",label_topology_kubernetes_io_zone="us-east-1b",label_topology_kubernetes_io_region="us-east-1",label_kubernetes_io_os="linux"} 1
kube_node_status_addresses{cluster="prod",node="worker-0",type="ExternalIP",address="10.0.1.10"} 1
kube_node_status_addresses{cluster="prod",node="worker-1",type="ExternalIP",address="10.0.1.11"} 1

# --- pods (labels.node drives cluster > node > pod nesting). ---
kube_pod_info{cluster="prod",namespace="prod",pod="gateway",uid="u-gateway",node="worker-0",pod_ip="10.244.1.30"} 1
kube_pod_info{cluster="prod",namespace="prod",pod="mongo-0",uid="u-mongo-0",node="worker-0",pod_ip="10.244.1.20"} 1
kube_pod_info{cluster="prod",namespace="prod",pod="mongo-1",uid="u-mongo-1",node="worker-1",pod_ip="10.244.2.21"} 1
kube_pod_info{cluster="prod",namespace="prod",pod="mongo-2",uid="u-mongo-2",node="worker-0"} 1

# --- pod owners -> data.owner -> synthesized controllers (Deployment gateway,
#     StatefulSet mongodb). owner_is_controller="true" required; kind verbatim.
#     argocd_tracking_id -> data.application (segment before the first ":"). ---
kube_pod_owner{cluster="prod",namespace="prod",pod="gateway",owner_kind="Deployment",owner_name="gateway",owner_is_controller="true",argocd_tracking_id="gateway:apps/Deployment:prod/gateway"} 1
kube_pod_owner{cluster="prod",namespace="prod",pod="mongo-0",owner_kind="StatefulSet",owner_name="mongodb",owner_is_controller="true",argocd_tracking_id="mongodb:apps/StatefulSet:prod/mongodb"} 1
kube_pod_owner{cluster="prod",namespace="prod",pod="mongo-1",owner_kind="StatefulSet",owner_name="mongodb",owner_is_controller="true",argocd_tracking_id="mongodb:apps/StatefulSet:prod/mongodb"} 1
kube_pod_owner{cluster="prod",namespace="prod",pod="mongo-2",owner_kind="StatefulSet",owner_name="mongodb",owner_is_controller="true",argocd_tracking_id="mongodb:apps/StatefulSet:prod/mongodb"} 1

# --- container images (kube_pod_container_info -> pod data.containers, {name,image}
#     sorted by name in the panel). gateway = app + envoy sidecar; each mongo
#     replica = mongod + a metrics exporter (2 containers). ---
kube_pod_container_info{cluster="prod",namespace="prod",pod="gateway",container="gateway",image="ghcr.io/acme/gateway:1.4.2"} 1
kube_pod_container_info{cluster="prod",namespace="prod",pod="gateway",container="envoy",image="envoyproxy/envoy:v1.31.0"} 1
kube_pod_container_info{cluster="prod",namespace="prod",pod="mongo-0",container="mongod",image="mongo:7.0"} 1
kube_pod_container_info{cluster="prod",namespace="prod",pod="mongo-0",container="metrics",image="bitnami/mongodb-exporter:0.40.0"} 1
kube_pod_container_info{cluster="prod",namespace="prod",pod="mongo-1",container="mongod",image="mongo:7.0"} 1
kube_pod_container_info{cluster="prod",namespace="prod",pod="mongo-1",container="metrics",image="bitnami/mongodb-exporter:0.40.0"} 1
kube_pod_container_info{cluster="prod",namespace="prod",pod="mongo-2",container="mongod",image="mongo:7.0"} 1
kube_pod_container_info{cluster="prod",namespace="prod",pod="mongo-2",container="metrics",image="bitnami/mongodb-exporter:0.40.0"} 1

# --- PVCs (one per mongo replica) + pod-mounts-pvc. ---
kube_pod_spec_volumes_persistentvolumeclaims_info{cluster="prod",namespace="prod",pod="mongo-0",persistentvolumeclaim="data-mongo-0",volume="data"} 1
kube_pod_spec_volumes_persistentvolumeclaims_info{cluster="prod",namespace="prod",pod="mongo-1",persistentvolumeclaim="data-mongo-1",volume="data"} 1
kube_pod_spec_volumes_persistentvolumeclaims_info{cluster="prod",namespace="prod",pod="mongo-2",persistentvolumeclaim="data-mongo-2",volume="data"} 1

# --- PVC StorageClass. kube_persistentvolumeclaim_info carries each PVC's `storageclass`
#     label; the backend (D6) draws a `pvc-to-storageclass` edge from each PVC to the
#     matching storageclass LEAF. All three mongo replicas share one StorageClass (a
#     StatefulSet volumeClaimTemplate uses a single storageClassName). ---
kube_persistentvolumeclaim_info{cluster="prod",namespace="prod",persistentvolumeclaim="data-mongo-0",storageclass="fast-ssd"} 1
kube_persistentvolumeclaim_info{cluster="prod",namespace="prod",persistentvolumeclaim="data-mongo-1",storageclass="fast-ssd"} 1
kube_persistentvolumeclaim_info{cluster="prod",namespace="prod",persistentvolumeclaim="data-mongo-2",storageclass="fast-ssd"} 1

# --- StorageClass definition. kube_storageclass_info materialises `fast-ssd` as a
#     cluster-level LEAF carrying its `provisioner` (D6). The PVCs above link to it via
#     pvc-to-storageclass edges; the node-detail Storage Class section shows the provisioner. ---
kube_storageclass_info{cluster="prod",storageclass="fast-ssd",provisioner="rook-ceph.rbd.csi.ceph.com",reclaim_policy="Delete",volume_binding_mode="WaitForFirstConsumer"} 1

# --- PVC ArgoCD application. kube_persistentvolumeclaim_annotations carries the same
#     annotation_argocd_argoproj_io_tracking_id label -> data.application. The mongodb
#     StatefulSet's three volumeClaimTemplate PVCs belong to the `mongodb` application,
#     so data-mongo-* nest under the mongodb application group too. ---
kube_persistentvolumeclaim_annotations{cluster="prod",namespace="prod",persistentvolumeclaim="data-mongo-0",annotation_argocd_argoproj_io_tracking_id="mongodb:apps/PersistentVolumeClaim:prod/data-mongo-0"} 1
kube_persistentvolumeclaim_annotations{cluster="prod",namespace="prod",persistentvolumeclaim="data-mongo-1",annotation_argocd_argoproj_io_tracking_id="mongodb:apps/PersistentVolumeClaim:prod/data-mongo-1"} 1
kube_persistentvolumeclaim_annotations{cluster="prod",namespace="prod",persistentvolumeclaim="data-mongo-2",annotation_argocd_argoproj_io_tracking_id="mongodb:apps/PersistentVolumeClaim:prod/data-mongo-2"} 1

# --- mongo-svc ClusterIP service. A 2-label `mongo-svc.prod.svc…` connection
#     string resolves to this Service node + fans service-selects-pod to mongo-*. ---
kube_service_info{cluster="prod",namespace="prod",service="mongo-svc",cluster_ip="10.96.0.10"} 1
# --- Service ArgoCD application. annotation_argocd_argoproj_io_tracking_id (KSM's
#     sanitised argocd.argoproj.io/tracking-id annotation) -> data.application (segment
#     before the first ":"). mongo-svc is part of the `mongodb` application, so it nests
#     under that application group alongside the mongodb controller + mongo-* pods. ---
kube_service_annotations{cluster="prod",namespace="prod",service="mongo-svc",annotation_argocd_argoproj_io_tracking_id="mongodb:apps/Service:prod/mongo-svc"} 1
kube_endpointslice_labels{cluster="prod",namespace="prod",endpointslice="mongo-svc-djk2",label_kubernetes_io_service_name="mongo-svc"} 1
kube_endpointslice_endpoints{cluster="prod",namespace="prod",endpointslice="mongo-svc-djk2",targetref_kind="Pod",targetref_namespace="prod",targetref_name="mongo-0"} 1
kube_endpointslice_endpoints{cluster="prod",namespace="prod",endpointslice="mongo-svc-djk2",targetref_kind="Pod",targetref_namespace="prod",targetref_name="mongo-1"} 1
kube_endpointslice_endpoints{cluster="prod",namespace="prod",endpointslice="mongo-svc-djk2",targetref_kind="Pod",targetref_namespace="prod",targetref_name="mongo-2"} 1

# =====================================================================
# cluster: dr — NATS StatefulSet + consumer Deployment behind nats-svc
# =====================================================================

# --- K8s node (worker-2). ---
kube_node_info{cluster="dr",node="worker-2"} 1
kube_node_labels{cluster="dr",node="worker-2",label_topology_kubernetes_io_zone="eu-west-1a",label_topology_kubernetes_io_region="eu-west-1",label_kubernetes_io_os="linux"} 1
kube_node_status_addresses{cluster="dr",node="worker-2",type="ExternalIP",address="10.0.2.10"} 1

# --- pods (consumer + nats-0/1/2, all on worker-2). ---
kube_pod_info{cluster="dr",namespace="dr",pod="consumer",uid="u-consumer",node="worker-2"} 1
kube_pod_info{cluster="dr",namespace="dr",pod="nats-0",uid="u-nats-0",node="worker-2"} 1
kube_pod_info{cluster="dr",namespace="dr",pod="nats-1",uid="u-nats-1",node="worker-2"} 1
kube_pod_info{cluster="dr",namespace="dr",pod="nats-2",uid="u-nats-2",node="worker-2"} 1

# --- pod owners -> Deployment consumer, StatefulSet nats.
#     argocd_tracking_id -> data.application (segment before the first ":"). ---
kube_pod_owner{cluster="dr",namespace="dr",pod="consumer",owner_kind="Deployment",owner_name="consumer",owner_is_controller="true",argocd_tracking_id="consumer:apps/Deployment:dr/consumer"} 1
kube_pod_owner{cluster="dr",namespace="dr",pod="nats-0",owner_kind="StatefulSet",owner_name="nats",owner_is_controller="true",argocd_tracking_id="nats:apps/StatefulSet:dr/nats"} 1
kube_pod_owner{cluster="dr",namespace="dr",pod="nats-1",owner_kind="StatefulSet",owner_name="nats",owner_is_controller="true",argocd_tracking_id="nats:apps/StatefulSet:dr/nats"} 1
kube_pod_owner{cluster="dr",namespace="dr",pod="nats-2",owner_kind="StatefulSet",owner_name="nats",owner_is_controller="true",argocd_tracking_id="nats:apps/StatefulSet:dr/nats"} 1

# --- container images. consumer = single container; each nats replica = server +
#     a config-reloader sidecar (2 containers). The reloader sidecar carries a
#     deliberately long, hyphenated name (`nats-server-config-reloader-sidecar`) so
#     the node-detail Containers table exercises the long-name + long-image layout
#     (the Name column must stay on one line — see ContainerTable name style). ---
kube_pod_container_info{cluster="dr",namespace="dr",pod="consumer",container="consumer",image="ghcr.io/acme/consumer:2.1.0"} 1
kube_pod_container_info{cluster="dr",namespace="dr",pod="nats-0",container="nats",image="nats:2.10-alpine"} 1
kube_pod_container_info{cluster="dr",namespace="dr",pod="nats-0",container="nats-server-config-reloader-sidecar",image="natsio/nats-server-config-reloader:0.16.0"} 1
kube_pod_container_info{cluster="dr",namespace="dr",pod="nats-1",container="nats",image="nats:2.10-alpine"} 1
kube_pod_container_info{cluster="dr",namespace="dr",pod="nats-1",container="nats-server-config-reloader-sidecar",image="natsio/nats-server-config-reloader:0.16.0"} 1
kube_pod_container_info{cluster="dr",namespace="dr",pod="nats-2",container="nats",image="nats:2.10-alpine"} 1
kube_pod_container_info{cluster="dr",namespace="dr",pod="nats-2",container="nats-server-config-reloader-sidecar",image="natsio/nats-server-config-reloader:0.16.0"} 1

# --- nats-svc ClusterIP service + service-selects-pod fan-out to nats-*. ---
kube_service_info{cluster="dr",namespace="dr",service="nats-svc",cluster_ip="10.96.0.50"} 1
# --- Service ArgoCD application: nats-svc belongs to the `nats` application, nesting
#     under the nats application group beside the nats controller + nats-* pods. ---
kube_service_annotations{cluster="dr",namespace="dr",service="nats-svc",annotation_argocd_argoproj_io_tracking_id="nats:apps/Service:dr/nats-svc"} 1
kube_endpointslice_labels{cluster="dr",namespace="dr",endpointslice="nats-svc-7f9q",label_kubernetes_io_service_name="nats-svc"} 1
kube_endpointslice_endpoints{cluster="dr",namespace="dr",endpointslice="nats-svc-7f9q",targetref_kind="Pod",targetref_namespace="dr",targetref_name="nats-0"} 1
kube_endpointslice_endpoints{cluster="dr",namespace="dr",endpointslice="nats-svc-7f9q",targetref_kind="Pod",targetref_namespace="dr",targetref_name="nats-1"} 1
kube_endpointslice_endpoints{cluster="dr",namespace="dr",endpointslice="nats-svc-7f9q",targetref_kind="Pod",targetref_namespace="dr",targetref_name="nats-2"} 1
